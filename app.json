{
  "expo": {
    "name": "Resonance Pulse",
    "slug": "resonance-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0d10",
    "scheme": "resonancepulse",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.resonancepulse.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Resonance Pulse connects to your Whoop band's Bluetooth heart-rate broadcast to measure beat-to-beat heart rate variability during breathing sessions."
      }
    },
    "android": {
      "package": "com.resonancepulse.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0d10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "Resonance Pulse connects to your Whoop band's Bluetooth heart-rate broadcast to measure beat-to-beat heart rate variability during breathing sessions."
        }
      ]
    ]
  }
}
